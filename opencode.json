{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "cmd *": "allow",
      "mysql --version": "allow",
      "sc query *": "allow",
      "mysqld --version": "allow"
    }
  },
  "command": {
    "complete": {
      "template": "输出完整可运行代码，禁止占位符，增加空值检查、异常捕获，严格遵循TypeScript强类型规范",
      "description": "完成当前子任务后执行三步收尾：git commit + 更新plan + 更新PROGRESS.md",
      "subtask": true
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "你的plan模型（如 opencode/某模型）",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "你的build模型（如 opencode/某模型）",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  }
}